    "error.unreadableFeed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن قراءة هذا التغذية. حاول مرة أخرى في وقت لاحق أو تحقق من عنوان URL للتأكد من صحته."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Немагчыма прачытаць гэты фід. Паспрабуйце пазней або праверце URL, каб пераканацца, што ён сапраўдны."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফিড পড়া সম্ভব নয়। পরে আবার চেষ্টা করুন বা URL চেক করুন এটি বৈধ কিনা নিশ্চিত করতে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht möglich, diesen Feed zu lesen. Versuche es später erneut oder überprüfe die URL, um sicherzustellen, dass sie gültig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not possible to read this feed. Try again later or check the URL to make sure it's valid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es posible leer este feed. Inténtalo de nuevo más tarde o verifica la URL para asegurarte de que sea válida."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabasa ang feed na ito. Subukang muli mamaya o i-check ang URL para matiyak na tama ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'est pas possible de lire ce flux. Réessayez plus tard ou vérifiez l'URL pour vous assurer qu'elle est valide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ीड को पढ़ना संभव नहीं है। बाद में पुन: प्रयास करें या URL की जांच करें ताकि यह सही हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak mungkin membaca umpan ini. Coba lagi nanti atau periksa URL untuk memastikan itu valid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile leggere questo feed. Riprova più tardi o controlla l'URL per assicurarti che sia valido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフィードを読み込むことができません。後でもう一度試すか、URLが有効であることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 피드를 읽을 수 없습니다. 나중에 다시 시도하거나 URL이 유효한지 확인하세요."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਫੀਡ ਪੜ੍ਹਨਾ ਸੰਭਵ ਨਹੀਂ ਹੈ। ਬਾਅਦ ਵਿੱਚ ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ ਜਾਂ URL ਨੂੰ ਚੈਕ ਕਰੋ ਕਿ ਇਹ ਵੈਧ ਹੈ ਕਿ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać tego kanału. Spróbuj ponownie później lub sprawdź, czy URL jest poprawny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível ler este feed. Tente novamente mais tarde ou verifique a URL para garantir que seja válida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível ler este feed. Tente novamente mais tarde ou verifique a URL para garantir que seja válida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно прочитать эту ленту. Попробуйте снова позже или проверьте URL, чтобы убедиться, что он правильный."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuk është e mundur të lexoni këtë feed. Provoni përsëri më vonë ose kontrolloni URL-në për t'u siguruar që është e vlefshme."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอ่านฟีดนี้ได้ โปรดลองใหม่อีกครั้งในภายหลังหรือตรวจสอบ URL เพื่อให้แน่ใจว่าถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu beslemeyi okumak mümkün değil. Daha sonra tekrar deneyin veya URL'nin geçerli olduğundan emin olun."
          }
        },
        "uk": {
