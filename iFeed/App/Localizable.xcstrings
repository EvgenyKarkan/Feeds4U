    "deleteAll.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes every feed and article from this device. This action cannot be undone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إزالة كل خلاصة ومقالة من هذا الجهاز نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта назаўжды выдаліць усе стужкі і артыкулы з гэтай прылады. Гэта дзеянне немагчыма адмяніць."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি এই ডিভাইস থেকে প্রতিটি ফিড এবং নিবন্ধ স্থায়ীভাবে সরিয়ে দেবে। এই ক্রিয়াটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Feeds und Artikel dauerhaft von diesem Gerät entfernt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente todas las fuentes y artículos de este dispositivo. Esta acción no se puede deshacer."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanenteng tatanggalin nito ang bawat feed at artikulo mula sa device na ito. Hindi na ito maibabalik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime définitivement tous les flux et articles de cet appareil. Elle est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे इस डिवाइस से हर फ़ीड और लेख स्थायी रूप से हट जाएगा। यह क्रिया पूर्ववत नहीं की जा सकती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus permanen setiap umpan dan artikel dari perangkat ini. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione rimuove definitivamente tutti i feed e gli articoli da questo dispositivo. L'azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作により、このデバイスからすべてのフィードと記事が完全に削除されます。元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 이 기기에서 모든 피드와 기사를 영구적으로 삭제합니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਇਸ ਡਿਵਾਈਸ ਤੋਂ ਹਰ ਫੀਡ ਅਤੇ ਲੇਖ ਨੂੰ ਪੱਕੇ ਤੌਰ 'ਤੇ ਹਟਾ ਦੇਵੇਗਾ। ਇਹ ਕਾਰਵਾਈ ਵਾਪਸ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕਦੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie wszystkich kanałów i artykułów z tego urządzenia. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove permanentemente todos os feeds e artigos deste dispositivo. Esta ação não pode ser desfeita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto remove permanentemente todos os feeds e artigos deste dispositivo. Esta ação não pode ser anulada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это безвозвратно удалит все ленты и статьи с этого устройства. Это действие нельзя отменить."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo heq përgjithmonë çdo feed dhe artikull nga kjo pajisje. Ky veprim nuk mund të zhbëhet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบทุกฟีดและบทความออกจากอุปกรณ์นี้อย่างถาวร ไม่สามารถยกเลิกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, bu cihazdaki tüm akışları ve makaleleri kalıcı olarak siler. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видалить усі стрічки та статті з цього пристрою. Цю дію не можна скасувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将从此设备永久删除所有订阅源和文章。此操作无法撤销。"
          }
        }
      }
    },
