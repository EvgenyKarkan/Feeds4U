    "deleteAll.confirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete All Feeds?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف جميع الخلاصات؟"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдаліць усе стужкі?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব ফিড মুছবেন?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Feeds löschen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar todas las fuentes?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Burahin ang lahat ng feed?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer tous les flux ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी फ़ीड हटाएँ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus semua umpan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare tutti i feed?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのフィードを削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 피드를 삭제하시겠습니까?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਰੀਆਂ ਫੀਡਾਂ ਮਿਟਾਉਣੀਆਂ ਹਨ?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć wszystkie kanały?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar todos os feeds?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar todos os feeds?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить все ленты?"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Të fshihen të gjitha feed-et?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบฟีดทั้งหมดไหม?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm akışlar silinsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити всі стрічки?"
          }
        },
        "zh-Hans": {
